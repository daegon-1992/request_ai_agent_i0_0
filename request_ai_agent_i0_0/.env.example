# Copy this file to the repository root as .env.local or set the variables in PowerShell.
# Do not commit real API keys.

REQUEST_AGENT_LLM_ENABLED=0
REQUEST_AGENT_LLM_FORM_EXTRACTION_ENABLED=1
REQUEST_AGENT_LLM_RERANK_ENABLED=1
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_CHAT_DEPLOYMENT=<your-chat-model-deployment-name>
# Also accepted when using the VectorDB+EmbedModels .env.txt naming:
# AZURE_DEPLOYMENT_NAME=<your-chat-model-deployment-name>
AZURE_OPENAI_API_VERSION=2024-10-21

# Read-only Chroma search.
# Put VectorDB+EmbedModels under the repo root, or set these paths explicitly.
REQUEST_AGENT_CHROMA_ENABLED=1
REQUEST_AGENT_VECTOR_SEARCH_ENABLED=1
REQUEST_AGENT_EMBEDDING_ENABLED=1
REQUEST_AGENT_EMBEDDING_BACKEND=local_e5
REQUEST_AGENT_VECTOR_BUNDLE_ROOT=VectorDB+EmbedModels
DEFAULT_DB_ROOT_PATH=VectorDB+EmbedModels/data
TEXT_MODEL_PATH=VectorDB+EmbedModels/models/multilingual-e5-large
CLIP_MODEL_PATH=VectorDB+EmbedModels/models/clip-vit-base-patch32

# Optional local prototype storage path for recent requests.
# REQUEST_AGENT_RECENT_STORE_PATH=tests_5-0_request_assist/request_ai_agent_h1_v10/.local/recent_requests.json
